@model TrustPathWebConsole.Domain.LeadCallLister
@{
    ViewBag.Title = "Lead";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Lead")">Lead</a></li>
                        <li class="breadcrumb-item active">Call</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("List", "LeadCall", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>
        <!-- /.card -->
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("Create", "LeadCall", new AjaxOptions() { UpdateTargetId = "divCreate", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmCreate" }))
            {
                <div id="divCreate"></div>
            }
        </div>
        <!-- /.card -->
    </section>
    <!-- /.content -->
</div>

