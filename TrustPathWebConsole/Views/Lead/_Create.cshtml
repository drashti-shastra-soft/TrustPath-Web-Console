@model TrustPathWebConsole.Domain.Lead

<div class="modal fade" id="modal-lead" tabindex="-1" aria-labelledby="CompanyModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="LeadModalLabel">Edit Lead</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="LeadModalLabel">Add Lead</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                @if (ViewBag.ShowCompany)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label> Company </label>
                            @Html.DropDownListFor(m => m.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control" })
                        </div>
                    </div>
                }

                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Phone Number<span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Enter Phone Number" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Email Address <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Enter Email Address" })
                        <span class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label>State <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.StateId, ViewBag.State as List<SelectListItem>, "Select State ", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Business Type <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BusinessTypeId, ViewBag.BusinessType as List<SelectListItem>, "Select Business Type", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label>Source <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SourceId, ViewBag.Source as List<SelectListItem>, "Select Source", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>


                <div class="row mb-2">
                    <div class="col">
                        <label>Assign Lead <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.AssignLead, ViewBag.AssignLead as List<SelectListItem>, "Select Assign Lead", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Lead Status <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.LeadStatus, ViewBag.LeadStatus as List<SelectListItem>, new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Requirement <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Requirement, new { @class = "form-control", placeholder = "Enter Requirement", rows = "3" })
                        <span class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/lead/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)

