@model TrustPathWebConsole.Domain.LeadCall

<div class="modal fade" id="modal-whatsapp-message" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model != null && Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="messageModalLabel">Edit Message</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="messageModalLabel">Add Message</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.LeadId)
                @Html.HiddenFor(m => m.CommunicationMode)
                @Html.Hidden("PhoneNumber", (string)ViewBag.PhoneNumber)
                <div class="row mb-2">
                    <div class="col">
                        <label>Message <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Message, new { @class = "form-control", placeholder = "Enter Message", rows = "3" })
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/lead-call/message.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)